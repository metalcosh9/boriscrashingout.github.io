---
const title = "boriscrashingout.github.io";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <h1>{title}</h1>
    <p></p>
    <div id="app"></div>

    <script>
      import { mountCounter } from "../scripts/counter";
      mountCounter(document.getElementById("app")!);
    </script>

    <style is:global>
      body { font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 16px; color: #000; background: #fff; }
      button { font: inherit; padding: 4px 10px; }
    </style>
  </body>
</html>
